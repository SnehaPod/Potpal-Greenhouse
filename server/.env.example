# Copy to server/.env and fill in. This file is read by `node --env-file=.env`.

PORT=3000

# Supabase: run `npx supabase status` (local) or see Project Settings → API (cloud)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=your-supabase-anon-key

# Plant.id / Kindwise: create a key at https://admin.kindwise.com
# SECRET: keep it on the server, never in client/.env
PLANT_ID_API_KEY=your-plant-id-api-key

# Where the Vue app runs (comma-separate several). Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# Pl@ntNet: the free backup identifier (500 IDs/day), used when Plant.id can't
# answer. Optional, but without it there's no fallback. Get a key at
# https://my.plantnet.org (check its terms allow your use before launch).
PLANTNET_API_KEY=your-plantnet-api-key

# Test switch. "false" skips Plant.id completely: identification goes straight
# to Pl@ntNet and health scans are paused, so testing spends no Plant.id credits.
# Leave unset (or "true") in production.
PLANT_ID_ENABLED=true
