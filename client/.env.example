# Copy to client/.env and fill in. Everything here ends up in the browser,
# so only public values belong here (the anon key is designed to be public).

VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: links for "Terms of Service" and "Privacy Policy" on the log-in screen.
# Leave unset until those pages exist; the words then show without a link.
# VITE_TERMS_URL=https://example.com/terms
# VITE_PRIVACY_URL=https://example.com/privacy
