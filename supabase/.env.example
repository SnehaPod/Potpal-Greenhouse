# Copy to supabase/.env (git-ignored). The Supabase CLI reads this file when it
# starts and fills in the env(...) values in supabase/config.toml.

# Google sign-in ("Continue with Google"). From your OAuth client at
# https://console.cloud.google.com/apis/credentials (see README → "Log in options").
# SECRET: the client secret must never be committed or put in client/.env.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
